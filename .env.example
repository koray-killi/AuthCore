# Server
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_SHUTDOWN_TIMEOUT=15s

# Database
DATABASE_URL=postgres://authcore:authcore@localhost:5432/authcore?sslmode=disable

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# SMTP (MailHog defaults)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@authcore.local
SMTP_USERNAME=
SMTP_PASSWORD=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_IP_REQUESTS=60
RATE_LIMIT_IP_WINDOW=1m
RATE_LIMIT_ACCOUNT_REQUESTS=10
RATE_LIMIT_ACCOUNT_WINDOW=1m
